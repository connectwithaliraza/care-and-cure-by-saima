# PostgreSQL connection string. Use SSL parameters when required by your host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/care_and_cure

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Canonical public origin, without a trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Public production URL used in canonical SEO output and robots.txt.
NEXT_PUBLIC_SITE_URL=https://careandcurebysaima.com
